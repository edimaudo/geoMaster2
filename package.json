{
  "name": "geomaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One geoMaster game with a daily location challenge and four country quiz modes, built with Reddit Devvit Web.",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "vite build --config vite.client.config.ts && vite build --config vite.server.config.ts",
    "watch:client": "vite build --config vite.client.config.ts --watch",
    "watch:server": "vite build --config vite.server.config.ts --watch",
    "dev": "npm run build && (npm run watch:client & npm run watch:server &) && devvit playtest",
    "playtest": "devvit playtest",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@devvit/analytics": "^0.15.0",
    "@devvit/web": "^0.15.0",
    "d3-geo": "^3.1.1",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^5.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "devvit": "^0.15.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
